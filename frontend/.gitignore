# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.vite
*.local

# Local env files (may hold a dev JWT) — keep .env.example committed
.env
.env.*
!.env.example

# Root .gitignore has a Python-oriented `lib/` rule that wrongly matches
# frontend/src/lib/. Re-include our Svelte source lib explicitly.
!src/lib/
!src/lib/**

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
