# Copy to .env.local for local development. Do NOT commit real tokens/secrets.

# Dev-only JWT used to authenticate the agent chat endpoints (/api/agent/*).
# HS256, payload {"sub": "<user_uuid>"}. Leave empty if you have no token yet;
# the AI panel will then show an inline "로그인이 필요합니다" message.
VITE_DEV_JWT=

# Backend the Vite dev server proxies /api to (defaults to http://localhost:8000).
VITE_API_TARGET=http://localhost:8000
