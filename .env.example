# Root .env — consumed by `make secrets` to create the k8s Secrets (values NEVER committed).
# Infra runs entirely on the kind cluster (Strimzi Kafka, in-cluster Schema Registry, PVC
# Postgres); bring it up with `make wait`. The endpoints below are the in-cluster service
# addresses the manifests inject — for host-local runs use a port-forward (make pf-sr / pf-pg).

# KIS API credentials — required by `make secrets` (creates the kis-credentials Secret)
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret

# In-cluster infra endpoints (Strimzi bootstrap / in-cluster SR / PVC Postgres)
KAFKA_BOOTSTRAP_SERVERS=invest-kafka-kafka-bootstrap.kafka.svc:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/invest_view
