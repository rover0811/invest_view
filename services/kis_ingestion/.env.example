# kis_ingestion environment variables
# Copy to .env and fill values. Do NOT commit .env.

# KIS API Credentials
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret

# KIS API URLs (Defaults provided in config.py)
# KIS_WS_URL=wss://ops.koreainvestment.com:21000
# KIS_APPROVAL_URL=https://openapi.koreainvestment.com:9443
# KIS_TOKEN_URL=https://openapi.koreainvestment.com:9443/oauth2/tokenP

# Ingestion Settings
# JSON-array string; production list set in compose
KIS_WATCH_SYMBOLS='["005930","000660"]'
KIS_SUBSCRIPTION_CAP=40

# Kafka Integration
KIS_KAFKA_ENABLED=true
# in-compose: kafka:29092; host uses localhost:9092
KIS_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KIS_KAFKA_TOPIC=stock-ticks
KIS_SCHEMA_REGISTRY_URL=http://schema-registry:8081
