{
  "namespace": "com.invest_view.events",
  "type": "record",
  "name": "StockPattern",
  "doc": "Technical pattern event generated by Flink and consumed by event-pattern-persistence",
  "fields": [
    {
      "name": "pattern_event_id",
      "type": "string",
      "doc": "Unique identifier for the pattern event (deterministic UUIDv5)"
    },
    {
      "name": "symbol",
      "type": "string",
      "doc": "Stock symbol (e.g., 005930)"
    },
    {
      "name": "market",
      "type": "string",
      "doc": "Market where the stock is traded (string to avoid Avro enum redefinition conflict with StockAlert.Market)"
    },
    {
      "name": "pattern_type",
      "type": {
        "type": "enum",
        "name": "PatternType",
        "namespace": "com.invest_view.events",
        "symbols": ["GOLDEN_CROSS", "DEAD_CROSS", "RSI_OVERSOLD", "RSI_OVERBOUGHT", "MACD_BULLISH", "MACD_BEARISH"],
        "doc": "Type of the technical pattern detected"
      },
      "doc": "Category of the pattern event"
    },
    {
      "name": "window_start",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Start time of the observation window"
    },
    {
      "name": "window_end",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "End time of the observation window"
    },
    {
      "name": "triggered_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Time when the pattern was triggered"
    },
    {
      "name": "trigger_values",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Key-value pairs of indicator values that triggered the pattern"
    },
    {
      "name": "strategy_name",
      "type": "string",
      "doc": "Name of the strategy that triggered the pattern"
    },
    {
      "name": "source_tick_event_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional reference to the source tick event ID"
    }
  ]
}
