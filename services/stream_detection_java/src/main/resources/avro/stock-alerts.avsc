{
  "namespace": "com.invest_view.events",
  "type": "record",
  "name": "StockAlert",
  "doc": "Stock alert event generated by Flink and consumed by alert-service",
  "fields": [
    {
      "name": "alert_event_id",
      "type": "string",
      "doc": "Unique identifier for the alert event (UUID)"
    },
    {
      "name": "symbol",
      "type": "string",
      "doc": "Stock symbol (e.g., 005930)"
    },
    {
      "name": "market",
      "type": {
        "type": "enum",
        "name": "Market",
        "namespace": "com.invest_view.events",
        "symbols": ["KRX", "NXT"],
        "doc": "Market identifier (KRX: Korea Exchange, NXT: Nextrade)"
      },
      "doc": "Market where the stock is traded"
    },
    {
      "name": "alert_type",
      "type": {
        "type": "enum",
        "name": "AlertType",
        "namespace": "com.invest_view.events",
        "symbols": ["PRICE_ALERT", "VI_IMMINENT", "MOMENTUM_SHIFT", "TRADING_HALT"],
        "doc": "Type of the alert"
      },
      "doc": "Category of the alert event"
    },
    {
      "name": "severity",
      "type": {
        "type": "enum",
        "name": "Severity",
        "namespace": "com.invest_view.events",
        "symbols": ["INFO", "WARNING", "CRITICAL"],
        "doc": "Severity level of the alert"
      },
      "doc": "Alert severity"
    },
    {
      "name": "observation_start_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Start time of the observation window"
    },
    {
      "name": "observation_end_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "End time of the observation window"
    },
    {
      "name": "triggered_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Time when the alert was triggered"
    },
    {
      "name": "trigger_values",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Key-value pairs of values that triggered the alert"
    },
    {
      "name": "source_tick_event_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional reference to the source tick event ID"
    },
    {
      "name": "rule_name",
      "type": "string",
      "doc": "Name of the rule that triggered the alert"
    }
  ]
}
