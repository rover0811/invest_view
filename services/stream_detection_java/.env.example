# Required (no defaults) — set before running StreamDetectionJob locally or in a non-FlinkDeployment context.
# In-cluster the FlinkDeployment manifests inject the Strimzi bootstrap shown below.
KAFKA_BOOTSTRAP_SERVERS=invest-kafka-kafka-bootstrap.kafka.svc:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Optional (defaults shown) — override to tune detection thresholds
PRICE_ALERT_THRESHOLD=0.03
VI_PROXIMITY_THRESHOLD=0.01

# Optional checkpoint storage (default file:///opt/flink/checkpoints)
CHECKPOINT_DIR=file:///opt/flink/checkpoints

# Optional parallelism (default 1 — MVP single-slot)
PARALLELISM=1

# Documented for future config-loading (currently hardcoded in StreamDetectionJob)
WINDOW_SECONDS=300
SLIDE_SECONDS=60
