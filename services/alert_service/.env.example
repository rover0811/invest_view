# alert_service environment variables
# Copy to .env and fill values. Do NOT commit .env.

ALERT_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invest_view
ALERT_SERVICE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALERT_SERVICE_KAFKA_TOPIC=stock-alerts
ALERT_SERVICE_KAFKA_CONSUMER_GROUP=alert-service-v1
ALERT_SERVICE_KAFKA_AUTO_OFFSET_RESET=latest
ALERT_SERVICE_SCHEMA_REGISTRY_URL=http://localhost:8081
ALERT_SERVICE_AVRO_SCHEMA_PATH=schemas/stock-alerts.avsc
ALERT_SERVICE_JWT_SECRET=replace-me-with-secret-min-32-chars
ALERT_SERVICE_JWT_ALGORITHM=HS256
ALERT_SERVICE_JWT_USER_ID_CLAIM=sub
ALERT_SERVICE_ALLOW_ORIGINS=[]
ALERT_SERVICE_HTTP_HOST=0.0.0.0
ALERT_SERVICE_HTTP_PORT=8000
ALERT_SERVICE_LOG_LEVEL=INFO
